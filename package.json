{
  "name": "hawa-distribution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:concurrency": "cd backend && php artisan test --filter=Order",
    "test:smoke": "node scripts/smoke-test.js",
    "test:perf": "node scripts/performance-audit.js",
    "test:e2e": "playwright test",
    "images:prewarm": "node scripts/prewarm-images.js",
    "quality-gate": "npm run typecheck && npm run lint && npm run test:run && npm run test:smoke",
    "ci": "npm run quality-gate && npm run test:e2e",
    "test:backend": "cd backend && php artisan test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sentry/nextjs": "^10.73.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "swiper": "^12.1.2",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
