{
  "name": "hawa-distribution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:concurrency": "tsx --test tests/order-concurrency-and-inventory.test.ts",
    "test:smoke": "node scripts/smoke-test.js",
    "test:perf": "node scripts/performance-audit.js",
    "test:e2e": "playwright test",
    "quality-gate": "npm run typecheck && npm run lint && npm run test:run && npm run test:smoke",
    "ci": "npm run quality-gate && npm run test:e2e",
    "db:import": "node scripts/importData.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "swiper": "^12.1.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
