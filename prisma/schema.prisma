generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String           @id @default(cuid())
  password            String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  username            String           @unique
  canDeleteBanners    Boolean          @default(true)
  canDeleteCategories Boolean          @default(true)
  canDeleteOrders     Boolean          @default(true)
  canDeleteProducts   Boolean          @default(true)
  canDeletePromoCodes Boolean          @default(true)
  canManageBanners    Boolean          @default(true)
  canManageCategories Boolean          @default(true)
  canManageOrders     Boolean          @default(true)
  canManageProducts   Boolean          @default(true)
  canManagePromoCodes Boolean          @default(true)
  role                Role             @default(ADMIN)
  canDeleteBrands     Boolean          @default(true)
  canManageBrands     Boolean          @default(true)
  canManageReviews    Boolean          @default(true)
  archivedAt          DateTime?
  disabledAt          DateTime?
  permissions         UserPermission[]
  auditLogs           AdminAuditLog[]  @relation("AdminAuditActor")

  @@index([archivedAt])
  @@index([disabledAt])
}

model UserPermission {
  userId     String
  permission AdminPermission
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([permission])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model AdminLoginAttempt {
  id         String   @id @default(cuid())
  keyHash    String
  scope      String
  successful Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([keyHash, scope, createdAt])
  @@index([createdAt])
}

model MainCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  showInNav   Boolean    @default(true)
  navOrder    Int        @default(0)
  isFeatured  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?
  categories  Category[]
  products    Product[]
  brands      Brand[]

  @@index([isActive, showInNav, navOrder])
  @@index([isFeatured])
  @@index([archivedAt])
}

model Category {
  id             String        @id @default(cuid())
  name           String
  description    String?
  image          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isFeatured     Boolean       @default(false)
  isActive       Boolean       @default(true)
  slug           String        @unique
  brandId        String
  brand          Brand         @relation(fields: [brandId], references: [id])
  products       Product[]
  mainCategoryId String?
  mainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id])
  archivedAt     DateTime?

  @@unique([brandId, name])
  @@index([brandId])
  @@index([mainCategoryId])
  @@index([isActive, archivedAt])
  @@index([isFeatured])
  @@index([isFeatured, updatedAt])
  @@index([archivedAt])
}

model Product {
  id              String         @id @default(cuid())
  name            String
  nameAr          String?
  nameEn          String?
  slug            String         @unique
  images          String
  isTrending      Boolean        @default(false)
  description     String?
  descriptionAr   String?
  descriptionEn   String?
  price           Decimal        @db.Decimal(10, 2)
  discountPrice   Decimal?       @db.Decimal(10, 2)
  discountType    String?
  discountValue   Decimal?       @db.Decimal(10, 2)
  stock           Int            @default(0)
  options         String?
  categoryId      String
  packaging       String?        @default("طرد")
  itemsPerPackage String?
  minOrder        Int            @default(1)
  hidePrice       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sku             String?
  brandId         String
  mainCategoryId  String?
  orderItems      OrderItem[]
  brand           Brand          @relation(fields: [brandId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  mainCategory    MainCategory?  @relation(fields: [mainCategoryId], references: [id])
  reviews         Review[]
  wishlistItems   WishlistItem[]
  archivedAt      DateTime?

  @@index([brandId])
  @@index([categoryId])
  @@index([mainCategoryId])
  @@index([isTrending])
  @@index([createdAt])
  @@index([name])
  @@index([categoryId, createdAt])
  @@index([brandId, createdAt])
  @@index([mainCategoryId, createdAt])
  @@index([price])
  @@index([stock])
  @@index([categoryId, price])
  @@index([brandId, price])
  @@index([updatedAt])
  @@index([discountPrice])
  @@index([isTrending, updatedAt])
  @@index([archivedAt])
}

model Brand {
  id             String        @id @default(cuid())
  name           String        @unique
  nameEn         String?
  slug           String        @unique
  description    String?
  image          String?
  group          BrandGroup    @default(DIFFERENT)
  isActive       Boolean       @default(true)
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  categories     Category[]
  products       Product[]
  mainCategoryId String?
  mainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id])
  archivedAt     DateTime?

  @@index([group])
  @@index([isActive])
  @@index([isFeatured])
  @@index([mainCategoryId])
  @@index([archivedAt])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    Int         @unique @default(autoincrement())
  totalAmount    Decimal     @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  city           String
  streetAddress  String
  Name           String
  phone          String
  shopName       String?
  notes          String?
  cancellationReason String? @db.Text
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  promoCodeId    String?
  promoCode      PromoCode?  @relation(fields: [promoCodeId], references: [id])
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  stockReserved  Boolean     @default(true)
  idempotencyKey String?     @unique
  requestHash    String?
  items          OrderItem[]
  archivedAt     DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([promoCodeId])
  @@index([customerId])
  @@index([archivedAt])
}

model Banner {
  id           String    @id @default(cuid())
  title        String?
  subtitle     String?
  titleAr      String?
  subtitleAr   String?
  image        String
  buttonText   String?   @default("Shop Now")
  buttonTextAr String?   @default("تسوق الآن")
  link         String?   @default("/products")
  badge        String?   @default("Certified Wholesale")
  badgeAr      String?   @default("توزيع جملة معتمد")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  @@index([isActive, createdAt])
  @@index([archivedAt])
}

model PromoCode {
  id                 String    @id @default(cuid())
  code               String    @unique
  discountPercentage Int
  delegateName       String?
  isActive           Boolean   @default(true)
  usageCount         Int       @default(0)
  totalSales         Decimal   @default(0) @db.Decimal(10, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  orders             Order[]
  archivedAt         DateTime?

  @@index([archivedAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  options   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id               String   @id @default(cuid())
  orderId          String?
  productId        String
  quantity         Int
  type             String
  reason           String?
  createdAt        DateTime @default(now())
  deduplicationKey String?  @unique

  @@index([orderId])
  @@index([productId])
  @@index([createdAt])
}

