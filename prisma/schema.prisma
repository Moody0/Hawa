model Review {
  id         String    @id @default(cuid())
  productId  String
  rating     Int
  feedback   String?
  image      String?
  name       String
  email      String?
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  archivedAt DateTime?

  @@index([productId])
  @@index([productId, isApproved])
  @@index([isApproved, createdAt])
  @@index([archivedAt])
}

model Customer {
  id         String         @id @default(cuid())
  shopName   String
  ownerName  String
  phone      String         @unique
  city       String
  address    String
  password   String
  notes      String?
  isActive   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orders     Order[]
  wishlist   WishlistItem[]
  archivedAt DateTime?

  @@index([phone])
  @@index([archivedAt])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  titleAr     String?
  slug        String    @unique
  excerpt     String?
  excerptAr   String?
  content     String    @db.Text
  contentAr   String?   @db.Text
  image       String?
  category    String    @default("أخبار الشركة")
  categoryAr  String?   @default("أخبار الشركة")
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  @@index([isPublished, createdAt])
  @@index([category])
  @@index([archivedAt])
}

model ContactMessage {
  id         String    @id @default(cuid())
  name       String
  phone      String
  shopName   String?
  city       String?
  message    String    @db.Text
  isRead     Boolean   @default(false)
  notes      String?   @db.Text
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([isRead])
  @@index([createdAt])
  @@index([phone])
  @@index([archivedAt])
}
