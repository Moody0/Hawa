enum OrderStatus {
  PENDING
  CONTACTED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum BrandGroup {
  MAIN
  DIFFERENT
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  rating      Int
  feedback    String?
  image       String?
  name        String
  email       String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isApproved])
}

model Customer {
  id           String         @id @default(cuid())
  shopName     String
  ownerName    String
  phone        String         @unique
  city         String
  address      String
  password     String
  notes        String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       Order[]
  wishlist     WishlistItem[]

  @@index([phone])
}

model WishlistItem {
  id         String    @id @default(cuid())
  customerId String
  productId  String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model Post {
  id          String   @id @default(cuid())
  title       String
  titleAr     String?
  slug        String   @unique
  excerpt     String?
  excerptAr   String?
  content     String   @db.Text
  contentAr   String?  @db.Text
  image       String?
  category    String   @default("أخبار الشركة")
  categoryAr  String?  @default("أخبار الشركة")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([category])
}
