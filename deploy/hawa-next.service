[Unit]
Description=Hawa Next.js storefront
After=network.target php8.5-fpm.service mysql.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/hawa/current
EnvironmentFile=/var/www/hawa/shared/frontend.env
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node scripts/start-server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
